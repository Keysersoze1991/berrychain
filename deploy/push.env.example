# /etc/berrychain/push.env (root and berry only). The push relay follows the
# local node and sends an Apple push when a letter reaches a registered address.
# Without the three APNS_* values it runs dry and sends nothing.
PUSH_NODE=http://127.0.0.1:8801
PUSH_PORT=8803
PUSH_DB=/var/lib/berrychain/push/registrations.json
PUSH_POLL_SECONDS=10
# Apple: an APNs auth key (.p8) from the developer portal, its Key ID, and the team.
APNS_KEY_FILE=/etc/berrychain/apns.p8
APNS_KEY_ID=ABC123DEFG
APNS_TEAM_ID=4LBMWPMKK6
APNS_TOPIC=link.berrychain.wallet
# 1 only for debug builds installed from Xcode; TestFlight and the App Store use production.
APNS_SANDBOX=0
