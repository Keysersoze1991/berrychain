# /etc/berrychain/parcels.env (root and berry only). The parcel room keeps sealed
# large attachments beside the chain and serves them to the letter's recipient.
PARCEL_NODE=http://127.0.0.1:8801
PARCEL_PORT=8804
PARCEL_DIR=/var/lib/berrychain/parcels
# Who parcels are paid to (an ordinary address; the network-operations wallet so parcels pay for their disk).
PARCEL_ADDRESS=brry1...
# 1 BERRY (100000000 seeds) per started 5 MB; at most 25 MB; kept 30 days.
PARCEL_PRICE_SEEDS=100000000
PARCEL_CHUNK_BYTES=5242880
PARCEL_MAX_BYTES=26214400
PARCEL_TTL_DAYS=30
PARCEL_POLL_SECONDS=10
