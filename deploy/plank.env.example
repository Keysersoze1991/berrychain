# /etc/berrychain/plank.env (root and berry only). Walk the Plank: the captain's daily trivia dive.
PLANK_PORT=8805
PLANK_DIR=/var/lib/berrychain/plank
PLANK_PROMPTS=/opt/berrychain/deploy/plank-prompts.txt
# seconds per prompt
PLANK_SECONDS=25
# Unknown answers are judged once by a model and the verdict cached. plank-setup.sh copies the key
# line from agent.env; without a key the judge is off and only listed answers count.
PLANK_MODEL=claude-haiku-5-5
PLANK_JUDGE_PER_DAY=3000
ANTHROPIC_API_KEY=
