# /etc/berrychain/ride.env (root and berry only). MTB Crazy: the record board and the referee.
RIDE_PORT=8806
RIDE_DIR=/var/lib/berrychain/ride
# The referee replays runs with Node on the same engine the page uses.
RIDE_NODE=/usr/bin/node
RIDE_CHECK=/opt/berrychain/site/ride/check.js
RIDE_REPLAY_SECONDS=20
# Where registered names are looked up (the local node). The Harbourmaster pays the prizes from
# RIDE_DIR/queue on its next tick (berrychain/purse.py).
RIDE_NODE_URL=http://127.0.0.1:8801
