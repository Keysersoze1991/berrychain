[Unit]
Description=BerryChain parcel room (large sealed attachments)
After=network-online.target berrychain-node.service
Wants=network-online.target

[Service]
Type=simple
User=berry
Group=berry
WorkingDirectory=/opt/berrychain
EnvironmentFile=/etc/berrychain/parcels.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/berrychain/.venv/bin/python -m berrychain.parcels
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/berrychain
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
