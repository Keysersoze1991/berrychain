# /etc/berrychain/node.env  (readable by root and the berry user only)
SEED_HOST=__SEED_HOST__
# comma-separated https URLs of the other seeds
PEERS=__PEERS__
# leave empty to not mine on this seed
MINER_ADDRESS=__MINER__
# required for POST /mine from anywhere but loopback; nginx blocks /mine anyway
BERRY_ADMIN_TOKEN=__ADMIN_TOKEN__
