[Unit]
Description=BerryChain standing agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=berry
Group=berry
WorkingDirectory=/opt/berrychain
EnvironmentFile=/etc/berrychain/agent.env
ExecStart=/opt/berrychain/.venv/bin/python -m berrychain.agent --config /etc/berrychain/agent.json
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/berrychain
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
